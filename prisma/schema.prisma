generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  phone         String?
  password      String?
  image         String?
  role          UserRole   @default(BUYER)
  status        UserStatus @default(ACTIVE)
  mpAccessToken String?
  mpUserId      String?
  mpPublicKey   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  accounts      Account[]
  orders        Order[]
  raffles       Raffle[]
  sessions      Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Raffle {
  id                 String       @id @default(cuid())
  slug               String       @unique
  title              String
  description        String?
  prize              String
  status             RaffleStatus @default(DRAFT)
  totalNumbers       Int
  pricePerNumber     Decimal      @db.Decimal(10, 2)
  minNumbers         Int          @default(1)
  maxNumbers         Int          @default(50)
  drawDate           DateTime?
  closedAt           DateTime?
  drawnAt            DateTime?
  coverImage         String?
  images             String[]     @default([])
  platformFeePercent Decimal      @default(5.00) @db.Decimal(5, 2)
  winnerNumber       Int?
  winnerId           String?
  whatsappNumber     String?
  sellerId           String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  numbers            Number[]
  orders             Order[]
  promotions         Promotion[]
  seller             User         @relation(fields: [sellerId], references: [id])

  @@map("raffles")
}

model Number {
  id         String       @id @default(cuid())
  number     Int
  status     NumberStatus @default(AVAILABLE)
  raffleId   String
  orderId    String?
  reservedAt DateTime?
  expiresAt  DateTime?
  soldAt     DateTime?
  order      Order?       @relation(fields: [orderId], references: [id])
  raffle     Raffle       @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  @@unique([raffleId, number])
  @@index([raffleId, status])
  @@map("numbers")
}

model Order {
  id              String      @id @default(cuid())
  status          OrderStatus @default(PENDING)
  buyerName       String
  buyerPhone      String
  buyerEmail      String?
  quantity        Int
  totalAmount     Decimal     @db.Decimal(10, 2)
  platformFee     Decimal     @db.Decimal(10, 2)
  sellerAmount    Decimal     @db.Decimal(10, 2)
  mpPaymentId     String?     @unique
  mpPreferenceId  String?
  mpStatus        String?
  mpQrCode        String?
  mpQrCodeText    String?
  whatsappLink    String?
  expiresAt       DateTime?
  raffleId        String
  buyerId         String?
  paidAt          DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  promotionId     String?
  reservedNumbers Int[]       @default([])
  numbers         Number[]
  buyer           User?       @relation(fields: [buyerId], references: [id])
  promotion       Promotion?  @relation(fields: [promotionId], references: [id])
  raffle          Raffle      @relation(fields: [raffleId], references: [id])

  @@index([raffleId])
  @@index([buyerPhone])
  @@index([mpPaymentId])
  @@map("orders")
}

model Promotion {
  id            String    @id @default(cuid())
  name          String
  quantity      Int
  promoPrice    Decimal   @db.Decimal(10, 2)
  originalPrice Decimal   @db.Decimal(10, 2)
  sortOrder     Int       @default(0)
  active        Boolean   @default(true)
  featured      Boolean   @default(false)
  startsAt      DateTime?
  endsAt        DateTime?
  usageCount    Int       @default(0)
  raffleId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders        Order[]
  raffle        Raffle?   @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  @@index([active, sortOrder])
  @@map("promotions")
}

model Settings {
  id    String @id @default("singleton")
  key   String @unique
  value String

  @@map("settings")
}

model Affiliate {
  id         String   @id @default(cuid())
  userId     String
  raffleId   String
  code       String   @unique
  commission Decimal  @db.Decimal(5, 2)
  clicks     Int      @default(0)
  sales      Int      @default(0)
  earnings   Decimal  @default(0) @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("affiliates")
}

enum UserRole {
  ADMIN
  SELLER
  BUYER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum RaffleStatus {
  DRAFT
  ACTIVE
  CLOSED
  DRAWN
  CANCELLED
}

enum NumberStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  REFUNDED
  CANCELLED
}
