# ============================================================
# RIFA AI — Variáveis de Ambiente
# Copie este arquivo como .env e preencha os valores reais.
# NUNCA commite o arquivo .env no Git!
# ============================================================

# ── Banco de Dados (Supabase PostgreSQL) ───────────────────
DATABASE_URL="postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-us-west-2.pooler.supabase.com:5432/postgres"

# ── NextAuth ───────────────────────────────────────────────
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET="gere-com-openssl-rand-base64-32"
NEXTAUTH_URL="https://seu-site.netlify.app"

# ── Google OAuth (opcional) ────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Mercado Pago ───────────────────────────────────────────
# Obtenha em: https://www.mercadopago.com.br/developers/panel
MP_ACCESS_TOKEN="APP_USR-..."
MP_PUBLIC_KEY="APP_USR-..."
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
# Secret para verificação do webhook (configure no painel do MP)
MP_WEBHOOK_SECRET=""

# ── Storage de Imagens (Vercel Blob ou similar) ────────────
BLOB_READ_WRITE_TOKEN=""

# ── Configurações da Plataforma ────────────────────────────
PLATFORM_FEE_PERCENT="5"
RESERVATION_MINUTES="15"

# ── URLs Públicas (prefixo NEXT_PUBLIC_ = exposto ao browser) ──
NEXT_PUBLIC_APP_URL="https://seu-site.netlify.app"
NEXT_PUBLIC_APP_NAME="RifaAI"
NEXT_PUBLIC_MP_PUBLIC_KEY="APP_USR-..."

# ── WhatsApp do Admin ──────────────────────────────────────
# Formato: código do país + DDD + número (sem espaços ou traços)
NEXT_PUBLIC_ADMIN_WHATSAPP="5511999999999"
